{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "verbatimModuleSyntax": false
  },
  "include": [
    "electron.vite.config.ts",
    "src/main/protocol.ts",
    "src/main/csp.ts",
    "src/main/menu.ts",
    "src/preload/index.ts",
    "src/preload/api.ts",
    "src/renderer/src/app-shell.tsx",
    "src/renderer/src/global.d.ts",
    "lib/domain/clip-ops.ts",
    "lib/domain/captions.ts",
    "lib/domain/apply-duration.ts",
    "lib/domain/export-bundle.ts",
    "lib/domain/export-presets.ts",
    "lib/domain/gap-chips.ts",
    "lib/domain/undo-stack.ts",
    "lib/domain/animatable.ts",
    "lib/domain/asr/verify.ts",
    "lib/domain/clip.ts",
    "lib/domain/effects.ts",
    "lib/domain/invariant.ts",
    "lib/domain/manifest-v2.ts",
    "lib/domain/model.ts",
    "lib/domain/ms.ts",
    "lib/domain/output-target.ts",
    "lib/domain/project.ts",
    "lib/domain/selection.ts",
    "lib/domain/source.ts",
    "lib/domain/timeline.ts",
    "lib/domain/timeline-interaction.ts",
    "lib/domain/track.ts",
    "lib/domain/transform.ts",
    "scripts/smoke-model.ts",
    "scripts/smoke-manifest.ts",
    "scripts/smoke-timeline-interaction.ts",
    "src/renderer/src/components/**/*.tsx",
    "src/renderer/src/components/**/*.ts"
  ],
  "exclude": ["scripts/fixtures/**", "out/**", "release/**"]
}
