{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "verbatimModuleSyntax": false
  },
  "include": [
    "electron.vite.config.ts",
    "src/main/protocol.ts",
    "src/main/csp.ts",
    "src/preload/index.ts",
    "src/preload/api.ts",
    "src/renderer/src/app-shell.tsx",
    "src/renderer/src/global.d.ts",
    "lib/domain/clip-ops.ts",
    "lib/domain/captions.ts",
    "lib/domain/apply-duration.ts",
    "lib/domain/export-bundle.ts",
    "lib/domain/export-presets.ts",
    "lib/domain/gap-chips.ts",
    "lib/domain/undo-stack.ts"
  ],
  "exclude": ["scripts/fixtures/**", "out/**", "release/**"]
}
