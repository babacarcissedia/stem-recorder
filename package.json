{
  "name": "stem-recorder",
  "productName": "Stem Studio",
  "version": "0.2.0",
  "private": false,
  "description": "Record screen/cam/mic stems and edit locally (timeline clips → ffmpeg apply).",
  "license": "MIT",
  "author": {
    "name": "Babacar Cisse Dia",
    "url": "https://bcd.dev"
  },
  "homepage": "https://github.com/babacarcissedia/stem-recorder",
  "bugs": {
    "url": "https://github.com/babacarcissedia/stem-recorder/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/babacarcissedia/stem-recorder.git"
  },
  "keywords": [
    "screen-recorder",
    "webcam",
    "multitrack",
    "stems",
    "electron",
    "ffmpeg",
    "editor",
    "timeline"
  ],
  "main": "out/main/index.js",
  "scripts": {
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.legacy.json",
    "typecheck:strict": "tsc --noEmit -p tsconfig.json",
    "preflight": "node scripts/preflight.js",
    "check:arch": "node scripts/check-architecture.js",
    "check:hex": "node scripts/check-hex-literals.js",
    "check:style": "node scripts/check-style-literals.js",
    "check:theme-parity": "node scripts/check-theme-parity.js",
    "check:contrast": "node scripts/check-contrast.js",
    "check:arch:self-test": "node scripts/check-architecture.js --self-test",
    "smoke:apply": "node scripts/smoke-apply.js",
    "smoke:clips": "node scripts/smoke-clip-ops.js",
    "smoke:model": "node scripts/smoke-model.ts",
    "smoke:menu": "node scripts/smoke-menu.ts",
    "smoke:pip": "node scripts/smoke-pip-filter.js",
    "smoke:freeze": "node scripts/smoke-freeze.js",
    "smoke:thumbs": "node scripts/smoke-thumbs.js",
    "smoke:gaps": "node scripts/smoke-gap-chips.js",
    "smoke:transcribe": "node scripts/smoke-transcribe.js",
    "smoke:captions": "node scripts/smoke-captions.js",
    "smoke:export": "node scripts/smoke-export.js",
    "smoke:captions-karaoke": "node scripts/smoke-captions-karaoke.js",
    "smoke:export-presets": "node scripts/smoke-export-presets.js",
    "smoke:export-bundle": "node scripts/smoke-export-bundle.js",
    "smoke:media-url": "node scripts/smoke-media-url.js",
    "smoke:color-range": "node scripts/smoke-color-range.js",
    "smoke:timeline-interaction": "node scripts/smoke-timeline-interaction.ts",
    "smoke:manifest": "node scripts/smoke-manifest.ts",
    "smoke:shortcuts": "node scripts/smoke-shortcuts.js",
    "smoke:theme": "node scripts/smoke-theme.js",
    "smoke:fonts": "node scripts/smoke-fonts.js"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^41.10.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "build": {
    "appId": "dev.bcd.stem-studio",
    "productName": "Stem Studio",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "out/**",
      "build/icon.png",
      "scripts/hf-whisper-transcribe.py",
      "scripts/hf_whisper.py"
    ],
    "mac": {
      "category": "public.app-category.video",
      "icon": "build/icon.png"
    },
    "win": {
      "icon": "build/icon.png"
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "AudioVideo"
    }
  }
}
