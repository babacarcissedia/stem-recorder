{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "strict": false,
    "noImplicitAny": false
  },
  "include": [
    "electron.vite.config.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "lib/domain/**/*.ts",
    "lib/node/**/*.js"
  ],
  "exclude": ["scripts/fixtures/**", "out/**", "release/**"]
}
